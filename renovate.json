{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>SierranaTech/actions//renovate/common-go"
  ],
  "packageRules": [
    {
      "description": "Group Go toolchain updates",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go toolchain",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "CI actions",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
